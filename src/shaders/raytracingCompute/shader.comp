#version 450 core 

struct WorldInfo
{
	vec4 color;
};

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;

layout (local_size_x = 8, local_size_y = 6, local_size_z = 1) in;

void main()
{
	uint ux = gl_GlobalInvocationID.x;
	uint uy = gl_GlobalInvocationID.y;
	
//	vec3 pixel = imageLoad(inputImage, ivec2(gl_GlobalInvocationID.xy)).rgb;
	
	imageStore(outputImage, ivec2(gl_GlobalInvocationID.xy), vec4(ux/800.f, uy/600.f, 0., 1.));
}
